<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="HardWrapDialogController">
            <connections>
                <outlet property="widthField" destination="DIA-TF-001" id="DIA-OU-001"/>
                <outlet property="window" destination="DIA-WN-001" id="DIA-OU-002"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Rewrap Markdown" releasedWhenClosed="NO" visibleAtLaunch="NO" id="DIA-WN-001">
            <windowStyleMask key="styleMask" titled="YES"/>
            <rect key="contentRect" x="0.0" y="0.0" width="290" height="120"/>
            <view key="contentView" id="DIA-CV-001">
                <rect key="frame" x="0.0" y="0.0" width="290" height="120"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField id="DIA-LB-001">
                        <rect key="frame" x="18" y="79" width="162" height="16"/>
                        <textFieldCell key="cell" editable="NO" selectable="NO" title="Width (0 unwraps):" id="DIA-TC-001">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField id="DIA-TF-001">
                        <rect key="frame" x="190" y="77" width="80" height="21"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" drawsBackground="YES" id="DIA-TC-002">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <button id="DIA-BT-001">
                        <rect key="frame" x="98" y="16" width="88" height="32"/>
                        <buttonCell key="cell" type="push" title="Cancel" bezelStyle="rounded" alignment="center" id="DIA-BC-001">
                            <font key="font" metaFont="system"/>
                            <string key="keyEquivalent" base64-UTF8="YES">Gw</string>
                        </buttonCell>
                        <connections>
                            <action selector="cancel:" target="-2" id="DIA-AC-001"/>
                        </connections>
                    </button>
                    <button id="DIA-BT-002">
                        <rect key="frame" x="184" y="16" width="92" height="32"/>
                        <buttonCell key="cell" type="push" title="Rewrap" bezelStyle="rounded" alignment="center" id="DIA-BC-002">
                            <font key="font" metaFont="system"/>
                            <string key="keyEquivalent" base64-UTF8="YES">DQ</string>
                        </buttonCell>
                        <connections>
                            <action selector="accept:" target="-2" id="DIA-AC-002"/>
                        </connections>
                    </button>
                </subviews>
            </view>
        </window>
    </objects>
</document>
